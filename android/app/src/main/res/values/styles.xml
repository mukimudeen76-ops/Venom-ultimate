<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Venom" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorSecondary">#EC4899</item>
        <item name="android:statusBarColor">#050505</item>
        <item name="android:navigationBarColor">#050505</item>
    </style>

    <style name="Theme.Venom.NoActionBar" parent="Theme.Venom">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
